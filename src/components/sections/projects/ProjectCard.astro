---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Icon from "../../ui/Icon.astro";

interface Props {
  project: CollectionEntry<"projects">;
  wide?: boolean;
}

const { project, wide = false } = Astro.props;
const href = `/work/${project.id}`;
---

<article
  class:list={[
    "group relative flex flex-col rounded-card bg-paper p-1 ring-1 ring-line transition duration-300 hover:-translate-y-1 hover:shadow-float",
    wide && "md:col-span-2",
  ]}
>
  <div class="flex h-[76px] items-center justify-between gap-4 px-5">
    <h3 class="min-w-0 text-[24px] font-bold leading-[1.1] tracking-[-0.025em] text-ink">
      <a href={href} class="transition group-hover:text-accent">
        {project.data.title}
      </a>
    </h3>
    <a
      href={href}
      aria-label={`Open ${project.data.title} case study`}
      class="grid h-[38px] w-[38px] shrink-0 place-items-center rounded-pill bg-ink text-inverse shadow-cta transition group-hover:bg-accent"
    >
      <Icon name="arrow-up-right" size={17} />
    </a>
  </div>

  <a
    href={href}
    tabindex="-1"
    aria-hidden="true"
    class="block overflow-hidden rounded-tile"
  >
    <Image
      src={project.data.cover}
      alt={project.data.coverAlt}
      widths={wide ? [640, 1000, 1400] : [420, 640, 976]}
      sizes={
        wide ? "(min-width: 768px) 1000px, 100vw" : "(min-width: 768px) 488px, 100vw"
      }
      format="webp"
      quality={82}
      loading="lazy"
      class:list={[
        "w-full object-cover transition duration-500 group-hover:scale-[1.02]",
        wide ? "h-[300px] lg:h-[376px]" : "h-[360px] md:h-[420px] lg:h-[526px]",
      ]}
    />
  </a>
</article>
