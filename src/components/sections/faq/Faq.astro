---
import type { CollectionEntry } from "astro:content";
import Container from "../../layout/Container.astro";
import FaqItem from "./FaqItem.astro";

interface Props {
  items: Array<CollectionEntry<"faq">>;
  title?: string;
  description?: string;
  id?: string;
  openFirst?: boolean;
}

const {
  items,
  title = "Got questions?",
  description = "The short version of what I do, how I work, and how to reach me.",
  id = "faq",
  openFirst = true,
} = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="pt-16 md:pt-24 lg:pt-[160px]">
  <Container class="flex flex-col gap-8 lg:grid lg:grid-cols-[323px_minmax(0,1fr)] lg:items-start lg:gap-8">
    <div class="flex flex-col gap-4">
      <h2 id={`${id}-title`} class="text-headline font-bold text-ink">
        {title}
      </h2>
      <p class="text-lead text-ink-muted">{description}</p>
    </div>

    <div class="flex w-full flex-col gap-6">
      {items.map((item, index) => (
        <FaqItem item={item} open={openFirst && index === 0} />
      ))}
    </div>
  </Container>
</section>
