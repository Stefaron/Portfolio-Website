---
import type { CollectionEntry } from "astro:content";
import Icon from "../../ui/Icon.astro";

interface Props {
  item: CollectionEntry<"faq">;
  open?: boolean;
}

const { item, open = false } = Astro.props;
---

<details class="group w-full rounded-faq bg-paper p-[26px] shadow-soft" open={open}>
  <summary class="flex cursor-pointer list-none items-center gap-5 [&::-webkit-details-marker]:hidden">
    <h3 class="flex-1 text-[20px] font-bold leading-[1.3] tracking-[-0.02em] text-ink">
      {item.data.question}
    </h3>
    <span class="grid h-[38px] w-[38px] shrink-0 place-items-center rounded-pill bg-ink text-inverse">
      <Icon name="plus" size={17} class="toggle-icon" />
    </span>
  </summary>
  <p class="mt-3.5 max-w-3xl text-[14px] leading-[23px] text-ink-muted">
    {item.data.answer}
  </p>
</details>
