---
import type { CollectionEntry } from "astro:content";
import Icon from "../../ui/Icon.astro";

interface Props {
  item: CollectionEntry<"faq">;
  open?: boolean;
}

const { item, open = false } = Astro.props;
---

<details class="group w-full rounded-faq bg-paper p-6 shadow-soft" open={open}>
  <summary class="flex min-h-[40px] cursor-pointer list-none items-center gap-4 [&::-webkit-details-marker]:hidden">
    <h3 class="flex-1 text-[24px] font-bold leading-[1.2] tracking-[-0.025em] text-ink">
      {item.data.question}
    </h3>
    <span class="grid h-11 w-11 shrink-0 place-items-center rounded-pill bg-ink text-inverse">
      <Icon name="plus" size={17} class="toggle-icon" />
    </span>
  </summary>
  <p class="mt-4 max-w-3xl text-[17px] leading-[1.6] text-ink-muted">
    {item.data.answer}
  </p>
</details>
