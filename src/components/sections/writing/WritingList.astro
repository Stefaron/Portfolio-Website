---
import type { CollectionEntry } from "astro:content";
import PublicationCard from "./PublicationCard.astro";
import WritingCard from "./WritingCard.astro";

interface Props {
  entries: Array<CollectionEntry<"writing">>;
}

const { entries } = Astro.props;
---

<div class="flex flex-col gap-5">
  {entries.map((entry) =>
    entry.data.kind === "paper" ? (
      <PublicationCard entry={entry} />
    ) : (
      <WritingCard entry={entry} />
    ),
  )}
</div>
