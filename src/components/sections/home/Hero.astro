---
import { Image } from "astro:assets";
import Container from "../../layout/Container.astro";
import Avatar from "../../ui/Avatar.astro";
import Pill from "../../ui/Pill.astro";
import Button from "../../ui/Button.astro";
import codeScreen from "../../../assets/images/media/code-screen.jpg";
import indonesiaPhoto from "../../../assets/images/media/indonesia.jpg";
import { site } from "../../../config/site";
---

<section class="pb-10 pt-10 md:pb-16 md:pt-20 lg:pb-[120px] lg:pt-[160px]">
  <Container class="flex flex-col gap-10 lg:gap-12">
    <h1 class="text-display font-bold text-ink">
      <span class="flex flex-wrap items-center gap-x-3.5 gap-y-2">
        <span>Hi, I'm</span>
        <Avatar class="h-[46px] w-[56px] rounded-pill border-2 border-paper shadow-hero sm:h-[58px] sm:w-[70px]" />
        <Pill>Evan</Pill>
      </span>

      <span class="flex flex-wrap items-center gap-x-3.5 gap-y-2">
        <span>an</span>
        <span class="inline-flex h-[46px] w-[56px] shrink-0 overflow-hidden rounded-pill border-2 border-paper shadow-hero sm:h-[58px] sm:w-[70px]">
          <Image
            src={codeScreen}
            alt="Code on a developer's screen"
            width={140}
            height={116}
            format="webp"
            quality={82}
            class="h-full w-full object-cover"
          />
        </span>
        <Pill>Software engineer</Pill>
        <span>from</span>
        <span class="inline-flex h-[46px] w-[56px] shrink-0 overflow-hidden rounded-pill border-2 border-paper shadow-hero sm:h-[58px] sm:w-[70px]">
          <Image
            src={indonesiaPhoto}
            alt="Prambanan temple in Yogyakarta, Indonesia"
            width={140}
            height={116}
            format="webp"
            quality={82}
            class="h-full w-full object-cover"
          />
        </span>
        <Pill>Indonesia</Pill>
      </span>

      <span class="mt-1 block">Engineering with vision.</span>
    </h1>

    <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
      <div class="flex max-w-[560px] flex-col gap-6">
        <p class="text-lead text-ink-muted">{site.hero.lead}</p>
        <div class="flex flex-wrap items-center gap-3">
          <Button href="#work" icon="arrow-down-right">
            View projects
          </Button>
          <Button href="/contact" variant="secondary">
            Get in touch
          </Button>
        </div>
      </div>

      <dl class="flex flex-col gap-3.5 lg:items-end">
        {site.hero.stats.map((stat) => (
          <div class="flex flex-col gap-0.5 lg:items-end">
            <dt class="text-[20px] font-bold leading-none tracking-[-0.4px] text-ink">
              {stat.value}
            </dt>
            <dd class="text-tiny text-ink-subtle">{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Container>
</section>
