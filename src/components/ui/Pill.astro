---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center justify-center rounded-pill bg-paper px-7 py-2 text-[clamp(1.4rem,2.78vw,2.5rem)] font-bold leading-[1.1] tracking-[-0.031em] text-ink shadow-float",
    className,
  ]}
>
  <slot />
</span>
