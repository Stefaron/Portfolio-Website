---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center justify-center rounded-pill bg-paper px-7 py-3 text-[length:var(--text-chip)] font-bold leading-[1.1] tracking-[-0.031em] text-ink shadow-float",
    className,
  ]}
>
  <slot />
</span>
