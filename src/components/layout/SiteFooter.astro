---
import Container from "./Container.astro";
import CtaBand from "./CtaBand.astro";
import { site } from "../../config/site";
---

<footer class="pt-16 md:pt-24 lg:pt-[160px]">
  <Container class="flex flex-col gap-6 pb-10">
    <CtaBand />

    <p class="text-center text-tiny font-semibold text-ink-subtle">
      © {new Date().getFullYear()} {site.name} · {site.location}
    </p>
  </Container>
</footer>
