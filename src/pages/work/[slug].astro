---
import { Image } from "astro:assets";
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import { getProjects } from "../../lib/content";
import { articleSchema } from "../../lib/seo";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const schema = articleSchema({
  title: project.data.title,
  description: project.data.summary,
  url: `/work/${project.id}`,
});
---

<ArticleLayout
  title={project.data.title}
  description={project.data.summary}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Work", href: "/work" },
    { label: project.data.title },
  ]}
  schema={schema}
>
  <div slot="meta" class="mt-8 flex flex-col gap-5">
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-pill bg-paper px-3.5 py-1.5 text-tiny font-semibold text-ink-muted shadow-soft">
        {project.data.year}
      </span>
      <span class="rounded-pill bg-paper px-3.5 py-1.5 text-tiny font-semibold text-ink-muted shadow-soft">
        {project.data.role}
      </span>
      {project.data.stack.map((item) => (
        <span class="rounded-pill bg-paper px-3.5 py-1.5 text-tiny font-semibold text-ink-muted shadow-soft">
          {item}
        </span>
      ))}
    </div>

    <dl class="grid grid-cols-2 gap-4 sm:grid-cols-3">
      {project.data.metrics.map((metric) => (
        <div class="flex flex-col gap-1">
          <dt class="text-[22px] font-bold leading-none tracking-[-0.4px] text-ink">
            {metric.value}
          </dt>
          <dd class="text-tiny text-ink-subtle">{metric.label}</dd>
        </div>
      ))}
    </dl>

    {project.data.links.length > 0 && (
      <ul class="flex flex-wrap gap-2">
        {project.data.links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.href.startsWith("http") ? "_blank" : undefined}
              rel={link.href.startsWith("http") ? "noreferrer" : undefined}
              class="inline-flex items-center gap-2 rounded-pill bg-ink px-4 py-2.5 text-tiny font-semibold text-inverse transition hover:bg-ink-muted"
            >
              <Icon name="external-link" size={14} />
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div slot="hero" class="mt-10 overflow-hidden rounded-card">
    <Image
      src={project.data.cover}
      alt={project.data.coverAlt}
      widths={[800, 1200, 1600]}
      sizes="(min-width: 1440px) 1280px, 100vw"
      format="webp"
      quality={85}
      class="h-auto w-full object-cover"
    />
  </div>

  <Content />

  <div
    slot="after"
    class="mt-14 flex flex-wrap items-center gap-3 border-t border-line pt-8"
  >
    <Button href="/work" variant="secondary" icon="arrow-left" iconPosition="start">
      All projects
    </Button>
    <Button href="/contact" icon="arrow-up-right">
      Talk about a project
    </Button>
  </div>
</ArticleLayout>
