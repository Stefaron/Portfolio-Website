---
import PageLayout from "../layouts/PageLayout.astro";
import Container from "../components/layout/Container.astro";
import Button from "../components/ui/Button.astro";
---

<PageLayout
  title="Page not found — Evan"
  description="The page you are looking for does not exist."
  noindex
>
  <Container class="flex min-h-[60vh] flex-col items-center justify-center gap-6 py-20 text-center">
    <p class="text-tiny font-bold uppercase tracking-[2px] text-accent">Error 404</p>
    <h1 class="text-headline font-bold text-ink">This page is not in the repo.</h1>
    <p class="max-w-md text-body text-ink-muted">
      The link may be old, or the page may have moved. The work and writing indexes are
      still where you left them.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <Button href="/" icon="arrow-right">
        Back home
      </Button>
      <Button href="/work" variant="secondary">
        View projects
      </Button>
    </div>
  </Container>
</PageLayout>
